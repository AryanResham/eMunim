OCR_PROVIDER=google_vision
GOOGLE_CLOUD_VISION_API_KEY=
# Optional hosted and hybrid extraction. Leave empty for LayoutLM-only use.
GROQ_API_KEY=
HOSTED_VLM_MODEL=
HOSTED_VLM_BASE_URL=https://api.groq.com/openai/v1
DATABASE_URL=
ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
ENVIRONMENT=production
REVIEW_THRESHOLD=75
FALLBACK_THRESHOLD=60
HYBRID_CONFLICT_POLICY=keep_local
