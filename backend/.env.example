# Copy to backend/.env; never put keys into frontend variables.
OCR_PROVIDER=google_vision
GOOGLE_CLOUD_VISION_API_KEY=
GROQ_API_KEY=
# Select a currently available image-capable Groq model in your account.
HOSTED_VLM_MODEL=
HOSTED_VLM_BASE_URL=https://api.groq.com/openai/v1
HOSTED_VLM_MAX_ATTEMPTS=2
# Respect provider Retry-After up to this bound; longer waits fail explicitly.
HOSTED_VLM_MAX_RETRY_WAIT_SECONDS=30
# Optional per-process spacing for free-tier batch work (e.g. 20 seconds).
HOSTED_VLM_MIN_INTERVAL_SECONDS=0
HOSTED_VLM_TIMEOUT_SECONDS=60
HOSTED_VLM_MAX_OUTPUT_TOKENS=2048
HOSTED_VLM_CACHE=true
# Text-only Groq model for the layoutlm_llm_vlm cascade. It tags OCR tokens and
# reuses the HOSTED_VLM_* key, URL, retry, pacing and cache settings above.
HOSTED_LLM_MODEL=

# Development thresholds in percent; calibrate on development data for research.
REVIEW_THRESHOLD=75
FALLBACK_THRESHOLD=60
MAX_UPLOAD_MB=10
# Empty = local backend/data/emunim.db SQLite. For PostgreSQL use:
# DATABASE_URL=postgresql://user:password@localhost:5432/emunim
DATABASE_URL=
# Optional alternate folder containing per-document-type trained model folders.
# LAYOUTLM_MODEL_ROOT=C:/path/to/models
LAYOUTLM_DEVICE=auto
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174"]
ENVIRONMENT=development
